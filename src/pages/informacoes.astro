---
import Base from '../layouts/Base.astro';
import dados from '../data/informacoes.json';
import torneio from '../data/torneio.json';
---

<Base titulo="Como chegar e alojamento" descricao="Informações práticas para equipas e visitantes: acessos, estacionamento, alojamento e restauração.">
  <div class="pagina-topo">
    <div class="container">
      <div class="migalhas"><a href="/">Início</a> / Informações</div>
      <h1>Informações úteis</h1>
      <p>Tudo o que precisa de saber para chegar, ficar e comer em Nelas.</p>
    </div>
  </div>

  <section>
    <div class="container">
      <div class="grelha grelha-3">
        {dados.blocos.map((b, i) => (
          <article class={`cartao info-cx revelar atraso-${(i % 3) + 1}`}>
            <h3><span>{b.icone}</span> {b.titulo}</h3>
            <ul>
              {b.itens.map((it) => (<li>{it}</li>))}
            </ul>
          </article>
        ))}
      </div>
      <p class="centro" style="margin-top:2.5rem">
        <a class="btn btn-escuro" target="_blank" rel="noopener" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(dados.mapa)}`}>Abrir mapa</a>
        <a class="btn btn-vermelho" href={`mailto:${torneio.email}`}>Perguntar à organização</a>
      </p>
    </div>
  </section>
</Base>
