---
import Base from '../layouts/Base.astro';
import dados from '../data/classificacoes.json';
---

<Base titulo="Classificações" descricao="Classificações por grupo e categoria do Nelas Cup.">
  <div class="pagina-topo">
    <div class="container">
      <div class="migalhas"><a href="/">Início</a> / Competição</div>
      <h1>Classificações</h1>
      <p>{dados.aviso}</p>
    </div>
  </div>

  <section>
    <div class="container">
      {dados.grupos.map((g) => (
        <div class="revelar">
          <h3>{g.titulo}</h3>
          <div class="tabela-caixa">
            <table class="tabela">
              <thead>
                <tr><th>#</th><th>Equipa</th><th>J</th><th>V</th><th>E</th><th>D</th><th>GM</th><th>GS</th><th>DG</th><th>Pts</th></tr>
              </thead>
              <tbody>
                {g.linhas.map((l, i) => (
                  <tr>
                    <td>{i + 1}</td>
                    <td><strong>{l.equipa}</strong></td>
                    <td>{l.j}</td><td>{l.v}</td><td>{l.e}</td><td>{l.d}</td>
                    <td>{l.gm}</td><td>{l.gs}</td><td>{l.gm - l.gs}</td>
                    <td class="pts">{l.pts}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
      <p class="pequeno">J jogos · V vitórias · E empates · D derrotas · GM golos marcados · GS golos sofridos · DG diferença de golos · Pts pontos.</p>
    </div>
  </section>
</Base>
